# DeadlockTutorLLM - Environment Configuration
# Copy this file to .env and configure as needed.

ENVIRONMENT=development
DEBUG=True

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- LLM Settings (Phase 4) ---
# Provider options: mock, ollama, openai, huggingface
LLM_PROVIDER=mock
PRIMARY_MODEL=Qwen/Qwen3-14B
FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_BASE=http://localhost:11434/v1

# NEVER commit real API keys to the repository
LLM_API_KEY=

# Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- RAG Settings (Phase 3) ---
# Provider options: mock, sentence-transformers
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-large-en
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=kb/processed/faiss_index
TOP_K_RETRIEVAL=5
RELEVANCE_THRESHOLD=0.25
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Knowledge Base Paths ---
KB_RAW_DIR=kb/raw
KB_PROCESSED_DIR=kb/processed
KB_METADATA_DIR=kb/metadata
