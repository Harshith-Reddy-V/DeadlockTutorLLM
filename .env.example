# ==================================================
# DeadlockTutorLLM Environment Configuration
# ==================================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
ENVIRONMENT=development
DEBUG=True

# LLM Provider Configuration
# Supported options: mock, local_hf, ollama, openai_compatible
LLM_PROVIDER=mock
PRIMARY_MODEL=Qwen/Qwen2.5-14B-Instruct
FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

# RAG & Embeddings Configuration
EMBEDDING_MODEL=BAAI/bge-large-en
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./kb/processed/faiss_index
TOP_K_RETRIEVAL=5

# Knowledge Base Paths
KB_RAW_DIR=./kb/raw
KB_PROCESSED_DIR=./kb/processed
KB_METADATA_DIR=./kb/metadata
